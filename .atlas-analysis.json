  },
  "keyFeatures": [
    "JWT access tokens with configurable short expiry (default 10 minutes)",
    "Secure HTTP-only cookie-based token storage (access_token + refresh_token)",
    "Refresh token rotation with 7-day expiry",
    "Token family tracking for refresh token reuse detection",
    "Account lockout after 5 failed login attempts (15-minute lock)",
    "Rate limiting on auth endpoints (5 requests/minute per IP)",
    "Device and IP tracking on refresh tokens",
    "Global logout (revoke all tokens across all devices)",
    "Automatic background cleanup of expired tokens every 6 hours",
    "BCrypt password hashing with user enumeration protection"
  ],
  "publicApiSurface": [
    "POST /register",
    "POST /login",
    "POST /refresh",
    "POST /logout",
    "POST /logout-all",
    "GET /secure"
  ]
}
