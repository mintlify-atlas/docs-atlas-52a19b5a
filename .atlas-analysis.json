  "projectType": "api-service",
  "projectName": "JWT Secure API",
  "projectDescription": "A secure ASP.NET Core REST API providing JWT-based authentication with refresh token rotation, device tracking, account lockout, and rate limiting.",
  "theme": "sequoia",
  "primaryColor": "#1E3A5F",
  "lightColor": "#2E6DA4",
